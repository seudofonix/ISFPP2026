<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.Controlador">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <Button fx:id="botonRecargar" mnemonicParsing="false" onAction="#recargar" text="Recargar datos" />
            <Label fx:id="etiquetaEstado" text="Sin datos cargados" />
         </children>
      </HBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab text="Vehiculos">
               <content>
                  <TableView fx:id="tablaVehiculos">
                     <columns>
                        <TableColumn fx:id="colVehPatente" prefWidth="100.0" text="Patente" />
                        <TableColumn fx:id="colVehModelo" prefWidth="160.0" text="Modelo" />
                        <TableColumn fx:id="colVehCapacidad" prefWidth="90.0" text="Capacidad" />
                        <TableColumn fx:id="colVehTipo" prefWidth="90.0" text="Tipo" />
                        <TableColumn fx:id="colVehCategoria" prefWidth="110.0" text="Categoria" />
                        <TableColumn fx:id="colVehServicios" prefWidth="200.0" text="Servicios" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Usuarios">
               <content>
                  <TableView fx:id="tablaUsuarios">
                     <columns>
                        <TableColumn fx:id="colUsuNombre" prefWidth="140.0" text="Nombre" />
                        <TableColumn fx:id="colUsuTelefono" prefWidth="110.0" text="Telefono" />
                        <TableColumn fx:id="colUsuEmail" prefWidth="170.0" text="Email" />
                        <TableColumn fx:id="colUsuRol" prefWidth="90.0" text="Rol activo" />
                        <TableColumn fx:id="colUsuLicencia" prefWidth="100.0" text="Licencia" />
                        <TableColumn fx:id="colUsuVehiculos" prefWidth="200.0" text="Vehiculos (patentes)" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Servicios">
               <content>
                  <TableView fx:id="tablaServicios">
                     <columns>
                        <TableColumn fx:id="colSerNombre" prefWidth="150.0" text="Nombre" />
                        <TableColumn fx:id="colSerBase" prefWidth="90.0" text="Tarifa base" />
                        <TableColumn fx:id="colSerKm" prefWidth="80.0" text="Precio/km" />
                        <TableColumn fx:id="colSerMinuto" prefWidth="90.0" text="Precio/min" />
                        <TableColumn fx:id="colSerVehiculo" prefWidth="90.0" text="Vehiculo" />
                        <TableColumn fx:id="colSerCategoria" prefWidth="100.0" text="Categoria" />
                        <TableColumn fx:id="colSerServicio" prefWidth="100.0" text="Servicio" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Cotizador">
               <content>
                  <VBox maxWidth="340.0" spacing="10.0">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                     <children>
                        <Label text="Servicio" />
                        <ComboBox fx:id="comboServicio" prefWidth="320.0" promptText="Elegi un servicio" />
                        <TextField fx:id="campoDistancia" promptText="Distancia (km)" />
                        <TextField fx:id="campoDuracion" promptText="Duracion (min)" />
                        <Button fx:id="botonCalcular" mnemonicParsing="false" onAction="#calcularCosto" text="Calcular costo" />
                        <Label text="Costo estimado" />
                        <Label fx:id="etiquetaCosto" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="-" />
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
