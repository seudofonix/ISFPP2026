<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.PanelClienteController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
         </padding>
         <children>
            <Label fx:id="etiquetaUsuario" style="-fx-font-weight: bold;" text="Usuario" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesion" />
         </children>
      </HBox>
   </top>
   <center>
      <TabPane fx:id="pestanias" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab text="Cotizar y reservar">
               <content>
                  <VBox spacing="14.0">
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                     <children>
                        <GridPane hgap="10.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" minWidth="70.0" />
                              <ColumnConstraints minWidth="150.0" />
                              <ColumnConstraints minWidth="150.0" />
                              <ColumnConstraints minWidth="110.0" />
                           </columnConstraints>
                           <children>
                              <Label text="Servicio" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <ComboBox fx:id="comboServicio" prefWidth="320.0" promptText="Elegi un servicio" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0" />
                              <Label text="Origen" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <TextField fx:id="txtLatOrigen" promptText="Latitud" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <TextField fx:id="txtLonOrigen" promptText="Longitud" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                              <Button mnemonicParsing="false" onAction="#generarOrigen" text="Aleatorio" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                              <Label text="Destino" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                              <TextField fx:id="txtLatDestino" promptText="Latitud" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              <TextField fx:id="txtLonDestino" promptText="Longitud" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                              <Button mnemonicParsing="false" onAction="#generarDestino" text="Aleatorio" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                           </children>
                        </GridPane>
                        <HBox spacing="12.0">
                           <children>
                              <Button fx:id="botonCotizar" mnemonicParsing="false" onAction="#cotizar" text="Cotizar viaje" />
                              <Button fx:id="botonReservar" disable="true" mnemonicParsing="false" onAction="#reservar" text="Reservar viaje" />
                           </children>
                        </HBox>
                        <GridPane hgap="12.0" vgap="6.0">
                           <children>
                              <Label text="Distancia (en linea recta)" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <Label fx:id="etiquetaDistancia" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <Label text="Duracion estimada" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <Label fx:id="etiquetaDuracion" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <Label text="Costo estimado" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                              <Label fx:id="etiquetaCosto" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                           </children>
                        </GridPane>
                        <Label text="Para reservar primero hay que cotizar; si cambias algun dato hay que volver a cotizar." wrapText="true" />
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Mis reservas">
               <content>
                  <VBox spacing="8.0">
                     <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                     </padding>
                     <children>
                        <TableView fx:id="tablaReservas" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colResId" prefWidth="80.0" text="Codigo" />
                              <TableColumn fx:id="colResFecha" prefWidth="140.0" text="Fecha" />
                              <TableColumn fx:id="colResServicio" prefWidth="100.0" text="Servicio" />
                              <TableColumn fx:id="colResOrigen" prefWidth="170.0" text="Origen" />
                              <TableColumn fx:id="colResDestino" prefWidth="170.0" text="Destino" />
                              <TableColumn fx:id="colResDistancia" prefWidth="90.0" text="Distancia" />
                              <TableColumn fx:id="colResCosto" prefWidth="100.0" text="Costo est." />
                              <TableColumn fx:id="colResEstado" prefWidth="100.0" text="Estado" />
                           </columns>
                        </TableView>
                        <HBox>
                           <children>
                              <Button fx:id="botonCancelar" disable="true" mnemonicParsing="false" onAction="#cancelarReserva" text="Cancelar reserva" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
