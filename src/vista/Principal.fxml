<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ControladorPrincipal">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#alRecargar" text="Recargar datos" />
            <Label fx:id="etiquetaEstado" text="Sin datos cargados" />
         </children>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab text="Vehiculos">
               <content>
                  <TableView fx:id="tablaVehiculos" columnResizePolicy="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN">
                     <columns>
                        <TableColumn fx:id="colVehPatente" text="Patente" />
                        <TableColumn fx:id="colVehModelo" text="Modelo" />
                        <TableColumn fx:id="colVehCapacidad" text="Capacidad" />
                        <TableColumn fx:id="colVehTipo" text="Tipo" />
                        <TableColumn fx:id="colVehCategoria" text="Categoria" />
                        <TableColumn fx:id="colVehServicios" text="Servicios" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Usuarios">
               <content>
                  <TableView fx:id="tablaUsuarios" columnResizePolicy="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN">
                     <columns>
                        <TableColumn fx:id="colUsuNombre" text="Nombre" />
                        <TableColumn fx:id="colUsuTelefono" text="Telefono" />
                        <TableColumn fx:id="colUsuEmail" text="Email" />
                        <TableColumn fx:id="colUsuRol" text="Rol activo" />
                        <TableColumn fx:id="colUsuLicencia" text="Licencia" />
                        <TableColumn fx:id="colUsuVehiculos" text="Vehiculos (patentes)" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Servicios">
               <content>
                  <TableView fx:id="tablaServicios" columnResizePolicy="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN">
                     <columns>
                        <TableColumn fx:id="colSerNombre" text="Nombre" />
                        <TableColumn fx:id="colSerBase" text="Tarifa base" />
                        <TableColumn fx:id="colSerKm" text="Precio/km" />
                        <TableColumn fx:id="colSerMinuto" text="Precio/min" />
                        <TableColumn fx:id="colSerVehiculo" text="Vehiculo" />
                        <TableColumn fx:id="colSerCategoria" text="Categoria" />
                        <TableColumn fx:id="colSerTipo" text="Servicio" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Cotizador">
               <content>
                  <VBox maxWidth="340.0" spacing="10.0">
                     <children>
                        <Label text="Servicio" />
                        <ComboBox fx:id="comboServicio" prefWidth="320.0" promptText="Elegi un servicio" />
                        <TextField fx:id="campoDistancia" promptText="Distancia (km)" />
                        <TextField fx:id="campoDuracion" promptText="Duracion (min)" />
                        <Button mnemonicParsing="false" onAction="#alCalcular" text="Calcular costo" />
                        <Label text="Costo estimado" />
                        <Label fx:id="etiquetaCosto" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="-" />
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
