<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefWidth="480.0" spacing="6.0" stylesheets="@Login.fx.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.impl.javafx.controller.LoginController">
   <padding>
      <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
   </padding>
   <children>
      <VBox alignment="CENTER" prefHeight="76.0" prefWidth="424.0">
         <children>
            <Label contentDisplay="CENTER" prefHeight="59.0" prefWidth="212.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="%app.titulo" textAlignment="CENTER">
               <font>
                  <Font name="BigBlueTerm437 Nerd Font Mono" size="13.0" />
               </font>
               <padding>
                  <Insets bottom="20.0" />
               </padding>
            </Label>
         </children>
      </VBox>
      <VBox fx:id="panelEmail" alignment="CENTER" spacing="8.0">
         <children>
            <Label text="%login.ingresaEmail" />
            <TextField fx:id="txtEmail" maxWidth="420.0" onAction="#handleContinuar" promptText="%login.emailEjemplo" />
            <Label fx:id="lblError" style="-fx-text-fill: #c0392b;" wrapText="true" />
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleContinuar" styleClass="primary-button" text="%login.continuar" />
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </VBox>
      <VBox fx:id="panelRol" alignment="CENTER" managed="false" spacing="8.0" visible="false">
         <children>
            <Label fx:id="lblSaludo" style="-fx-font-weight: bold;" wrapText="true" />
            <Label text="%login.comoIngresar" />
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <Button fx:id="btnComoUsuario" mnemonicParsing="false" onAction="#handleIngresarComoUsuario" styleClass="primary-button" text="%login.usuario" />
                  <Button fx:id="btnComoConductor" mnemonicParsing="false" onAction="#handleIngresarComoConductor" styleClass="primary-button" text="%login.conductor" />
               </children>
            </HBox>
            <Button mnemonicParsing="false" onAction="#handleCambiarMail" styleClass="secondary-button" text="%login.otroMail" />
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </VBox>
      <Label fx:id="lblDetalle" wrapText="true" />
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleRecargarDatos" styleClass="secondary-button" text="%login.recargar" />
            <ComboBox fx:id="cmbIdioma" />
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </HBox>
      <Label fx:id="lblEstado" text="%login.sinDatos" wrapText="true" />
   </children>
</VBox>
