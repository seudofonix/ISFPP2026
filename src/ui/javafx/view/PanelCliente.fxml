<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane prefHeight="700.0" prefWidth="1180.0" style="-fx-background-color: #FFFFFF;" stylesheets="@PanelCliente.fx.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.impl.javafx.controller.PanelClienteController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
         </padding>
         <children>
            <Label fx:id="lblUsuario" style="-fx-font-weight: bold;" text="Usuario" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#handleCerrarSesion" text="Cerrar sesion" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="400.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="12.0" right="12.0" top="4.0" />
         </padding>
         <children>
            <VBox fx:id="panelFormulario" spacing="10.0">
               <children>
                  <Label text="Servicio" />
                  <ComboBox fx:id="cmbServicios" maxWidth="1.7976931348623157E308" promptText="Elegi un servicio" />
                  <Button fx:id="btnElegirPuntos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleElegirPuntos" text="Elegir origen y destino en el mapa" />
                  <Label fx:id="lblPaso" wrapText="true" />
                  <GridPane hgap="8.0" vgap="8.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="52.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                     </columnConstraints>
                     <children>
                        <Label text="Origen" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtOrigen" editable="false" promptText="Elegi el origen en el mapa" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Destino" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtDestino" editable="false" promptText="Elegi el destino en el mapa" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                  </GridPane>
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="btnCotizar" disable="true" mnemonicParsing="false" onAction="#handleCotizar" text="Cotizar viaje" />
                        <Button fx:id="btnSolicitar" disable="true" mnemonicParsing="false" onAction="#handleSolicitarViaje" text="Solicitar y visualizar viaje" />
                     </children>
                  </HBox>
                  <GridPane hgap="10.0" vgap="5.0">
                     <children>
                        <Label text="Distancia" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblDistancia" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Tiempo estimado" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblTiempo" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Costo estimado" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="lblCosto" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label style="-fx-text-fill: #1763c0;" text="Recogida (azul)" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="lblRecogida" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label style="-fx-text-fill: #149566;" text="Traslado (verde)" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="lblTraslado" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     </children>
                     <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                  </GridPane>
               </children>
            </VBox>
            <Label text="Estado del viaje" />
            <TextArea fx:id="txtAreaEstado" editable="false" prefRowCount="7" wrapText="true" />
            <Button fx:id="btnCancelarViaje" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCancelarViaje" text="Cancelar viaje" />
         </children>
      </VBox>
   </left>
   <center>
      <WebView fx:id="mapaWeb" prefHeight="-1.0" prefWidth="-1.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
